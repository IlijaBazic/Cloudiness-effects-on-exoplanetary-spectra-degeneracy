# Jupyter Notebook checkpoints (hidden folder that Јupyter makes on its own)
.ipynb_checkpoints/

# Python cache (automatically generated executing files)
__pycache__/
*.pyc
*.pyo
*.pyd

# nbqa & Pylint cache
.nbqa_cache/
.pylintcache

# OS generated files
Thumbs.db

# Ignore all generated PNG images (view renderings & diagnostic plots)
*.png

# Ignore results directory if it contains heavy PNG outputs
output_results/**/*.png

#Ignore temporary and html files
*.html
*tmp*

#Local files
geckodriver.log
Plan za statistički dodatak.txt